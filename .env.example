# CivicConnect Environment Variables Template
# Copy this file to .env and configure your local MySQL database credentials.

# Server Port (Default: 5000)
PORT=5000

# Node Environment
NODE_ENV=development

# MySQL Database Connection URL
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE_NAME
DATABASE_URL="mysql://root:password@localhost:3306/civicconnect"

# JWT Secret for Authentication & Role-Based Access Control
JWT_SECRET="replace_with_a_secure_jwt_secret_in_production"

# Frontend Origin for CORS Allowed Requests
CORS_ORIGIN="http://localhost:5173"

# Frontend API Base URL for Vite Client Requests
VITE_API_BASE_URL="http://localhost:5000/api"

