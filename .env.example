# CivicConnect Environment Variables Template
# Copy this file to .env and configure your local MySQL database credentials.

# Server Port (Default: 5000)
PORT=5000

# Node Environment
NODE_ENV=development

# MySQL Database Connection URL
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE_NAME
DATABASE_URL="mysql://root:password@localhost:3306/civicconnect"

# JWT Secret for Authentication & Role-Based Access Control
JWT_SECRET="replace_with_a_secure_jwt_secret_in_production"

# Initial administrator credentials (used by API startup and `npm run seed:admin`)
ADMIN_EMAIL="administrator@example.gov"
ADMIN_PASSWORD="replace_with_a_long_unique_password"
# Optional; if omitted, the part of ADMIN_EMAIL before @ is used as the display name.
# ADMIN_NAME="Administrator"

# Frontend Origin for CORS Allowed Requests
CORS_ORIGIN="http://localhost:5174,http://192.168.56.1:5174,http://10.209.36.248:5174"

# Frontend API Base URL. Use /api to route requests through the Vite proxy.
# Set an absolute URL only when the frontend and API are hosted separately.
VITE_API_BASE_URL="/api"

# Browser-visible Geoapify key for OSM-based map tiles, autocomplete, and reverse geocoding.
# Restrict the key by allowed website referrers/origins in Geoapify.
VITE_GEOAPIFY_API_KEY="your_geoapify_key"

# Complaint duplicate detection tuning
DUPLICATE_POSSIBLE_THRESHOLD=0.55
DUPLICATE_LIKELY_THRESHOLD=0.82
DUPLICATE_RADIUS_METERS=300
DUPLICATE_DATE_WINDOW_DAYS=45
