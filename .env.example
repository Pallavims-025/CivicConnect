# CivicConnect Environment Variables Example (MySQL Backend)
# Copy this file to .env and configure your MySQL database credentials when connecting a backend server.

# Server Port
PORT=5000

# MySQL Database Connection URL (Optional future backend)
# Example: mysql://USERNAME:PASSWORD@HOST:PORT/civicconnect
DATABASE_URL="mysql://root:password@localhost:3306/civicconnect"

# Client Vite Dev Server URL
VITE_API_BASE_URL="http://localhost:5000/api"
